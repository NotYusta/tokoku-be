# =======================
# Application settings
# =======================
APP_PORT=3000
APP_BIND=0.0.0.0
JWT_SECRET=supersecretjwtkey123
ENCRYPTION_KEY=32byteencryptionkeyhere!
LOG_LEVEL=debug

# =======================
# Database settings
# =======================
DB_NAME=tokoku_db
DB_USER=tokoku_user
DB_PASSWORD=supersecurepassword
DB_HOST=127.0.0.1
DB_PORT=3306
DB_ROOT_PASSWORD=rootpassword

# =========================
# Xendit
# =========================
XENDIT_API_KEY=sk_test_xxx_replace_me
XENDIT_WEBHOOK_TOKEN=whsec_xxx_replace_me

# =======================
# Notifications / Webhooks
# =======================

# Discord webhook (single)
DISCORD_WEBHOOK_URLS=https://discord.com/api/webhooks/xxx/yyy

# Custom webhooks (comma-separated)
#CUSTOM_WEBHOOK_URLS=https://example.com/webhook/order,https://example.com/webhook/payment

# =======================
# Environment
# =======================
NODE_ENV=development
